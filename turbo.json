{
  "$schema": "https://v2-9-16.turborepo.dev/schema.json",
  "globalPassThroughEnv": ["COREPACK_HOME"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:tunnel": {
      "cache": false,
      "persistent": true
    },
    "dev:without-third-parties": {
      "cache": false,
      "persistent": true
    },
    "dev:without-third-parties:tunnel": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**", "locales/**/*.ts"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:run": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "install:ffmpeg": {
      "cache": false
    },
    "sentry:prod": {
      "cache": false,
      "env": ["SENTRY_AUTH_TOKEN"],
      "dependsOn": ["build"]
    },
    "prod": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "topo": {
      "dependsOn": ["^topo"]
    },
    "check:types": {
      "dependsOn": ["^topo", "^build"],
      "outputs": []
    },
    "@flicktionary/extension#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@flicktionary/api-client#build"]
    },
    "@flicktionary/extension#dev:firefox": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@flicktionary/api-client#build"]
    },
    "@flicktionary/extension#build": {
      "dependsOn": ["@flicktionary/api-client#build"],
      "inputs": [
        "src/**",
        "common/**",
        "public/**",
        "wxt.config.ts",
        "tsconfig.json"
      ],
      "outputs": [".output/**", ".wxt/**"]
    },
    "check:changes": {
      "cache": false,
      "outputs": []
    },
    "native:start": {
      "cache": false,
      "persistent": true
    },
    "native:android": {
      "cache": false,
      "persistent": true
    },
    "native:ios": {
      "cache": false,
      "persistent": true
    },
    "native:build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
