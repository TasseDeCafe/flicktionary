{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,

    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@flicktionary/api-client/*": ["../../packages/api-client/src/*"],
      "@flicktionary/core/*": ["../../packages/core/src/*"],
      "@flicktionary/i18n/locales/*": ["../../packages/i18n/locales/*"],
      "@flicktionary/i18n/*": ["../../packages/i18n/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "uniwind-types.d.ts"],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js", "android", "ios", "scripts"]
}
