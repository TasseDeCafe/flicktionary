{
  "private": true,
  "name": "@flicktionary/extension",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "doppler run --project extension --config dev_personal -- wxt",
    "dev:tunnel": "pnpm run dev",
    "dev:firefox": "doppler run --project extension --config dev_personal -- wxt -b firefox",
    "build": "wxt build",
    "build:dev": "doppler run --project extension --config dev_personal -- wxt build",
    "build:prod": "doppler run --project extension --config prd -- wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "pnpm run check && doppler run --project extension --config prd -- wxt zip",
    "zip:firefox": "pnpm run check && doppler run --project extension --config prd -- wxt zip -b firefox",
    "check:types": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "check": "pnpm run lint && pnpm run check:types",
    "lint": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@flatten-js/interval-tree": "catalog:",
    "@flicktionary/api-client": "workspace:*",
    "@flicktionary/core": "workspace:*",
    "@flicktionary/i18n": "workspace:*",
    "@flicktionary/ui": "workspace:*",
    "@floating-ui/dom": "catalog:",
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@mozilla/readability": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "@qgustavor/srt-parser": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@types/chrome": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/semver": "catalog:",
    "ass-compiler": "catalog:",
    "clsx": "catalog:",
    "fast-xml-parser": "catalog:",
    "hotkeys-js": "catalog:",
    "jsonschema": "catalog:",
    "lucide-react": "catalog:",
    "m3u8-parser": "catalog:",
    "mpd-parser": "catalog:",
    "react": "catalog:",
    "react-colorful": "catalog:",
    "react-device-detect": "catalog:",
    "react-dom": "catalog:",
    "regenerator-runtime": "catalog:",
    "sanitize-filename": "catalog:",
    "semver": "catalog:",
    "sonner": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:",
    "videojs-vtt.js": "catalog:"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/videojs-vtt.js": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@wxt-dev/module-react": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "wxt": "catalog:"
  }
}
