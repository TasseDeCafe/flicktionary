{
  "name": "@flicktionary/backend",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "description": "",
  "type": "module",
  "main": "dist/apps/backend/src/index.js",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "VITEST_ENV=unit vitest",
    "test:unit:run": "VITEST_ENV=unit vitest run",
    "test:integration": "VITEST_ENV=integration ./scripts/test--integration.sh",
    "test:integration:run": "VITEST_ENV=integration ./scripts/test--integration--run.sh",
    "check-templates": "node scripts/check-templates.js",
    "build-emails": "npx tsx scripts/build-email-templates.ts",
    "load:kaikki": "npx tsx scripts/load-kaikki.ts",
    "verify:kaikki-load": "npx tsx scripts/verify-kaikki-load.ts",
    "export:wordfreq": "uv run scripts/export-wordfreq.py",
    "build:lemma-ranks": "npx tsx scripts/build-lemma-ranks.ts",
    "load:reference-data": "pnpm run export:wordfreq && pnpm run load:kaikki && pnpm run build:lemma-ranks",
    "db:advance-day": "npx tsx scripts/advance-practice-day.ts",
    "db:dev:tunnel:reset": "./scripts/db--dev-tunnel--reset.sh",
    "db:dev:tunnel:wipe": "./scripts/db--dev-tunnel--wipe.sh",
    "db:dev:tunnel:migrate": "./scripts/db--dev-tunnel--migrate.sh",
    "db:dev:tunnel:gen-types": "./scripts/db--dev-tunnel--gen-types.sh",
    "preview-emails": "email dev --dir emails",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "check:types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "build:dev": "npx tsc --project tsconfig.dev.json && npx tsc-alias --project tsconfig.dev.json",
    "db:test": "./scripts/db--test.sh",
    "db:dev": "./scripts/db--dev.sh",
    "db:dev:tunnel": "scripts/db--dev--tunnel.sh",
    "db:stop-all": "./scripts/db--stop-all.sh",
    "dev": "./scripts/dev.sh",
    "dev:tunnel": "scripts/dev--tunnel.sh",
    "dev:without-third-parties": "./scripts/dev--without-third-parties.sh",
    "dev:without-third-parties:tunnel": "scripts/dev--without-third-parties--tunnel.sh",
    "build": "scripts/build--prod.sh",
    "prod": "scripts/deployment/prod.sh",
    "build:and:prod": "pnpm run build && pnpm run prod",
    "check:changes": "scripts/deployment/check-backend-changes.sh"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "author": "TasseDeCafe",
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
