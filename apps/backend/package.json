    "jose": "catalog:",
    "jsonwebtoken": "catalog:",
    "jwks-rsa": "catalog:",
    "morgan": "catalog:",
    "node-cache": "catalog:",
    "postgres": "catalog:",
    "posthog-node": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "resend": "catalog:",
    "stripe": "catalog:",
    "ts-fsrs": "catalog:",
    "turbo": "catalog:",
    "zod": "catalog:"
