    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "openapi-typescript": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-email": "catalog:",
    "supertest": "catalog:",
    "tsc-alias": "catalog:",
