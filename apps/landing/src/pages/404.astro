---
import Base from '../layouts/Base.astro'
---

<Base title='Page not found — Flicktionary' description='This page does not exist.'>
  <main class='mx-auto flex max-w-3xl flex-col items-center px-6 py-24 text-center'>
    <h1 class='text-4xl font-extrabold tracking-tight'>Page not found</h1>
    <p class='mt-4 text-gray-600'>The page you are looking for does not exist.</p>
    <a href='/' class='mt-8 rounded-full bg-ink px-7 py-3 font-semibold text-white transition hover:bg-black'>
      Back to the home page
    </a>
  </main>
</Base>
