{
  "name": "flicktionary.app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:tunnel": "scripts/dev-tunnel.sh",
    "start-tunnels": "scripts/start-tunnels.sh",
    "prod:backend:sentry": "turbo run sentry:prod --filter=@flicktionary/backend",
    "prod:backend:build": "turbo run build --filter=@flicktionary/backend",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "knip": "knip",
    "check:types": "turbo run check:types",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "verify": "scripts/verify.sh",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "translate": "pnpm --filter @flicktionary/i18n translate",
    "translate:sync": "pnpm lingui extract --clean && pnpm --filter @flicktionary/i18n translate && pnpm lingui extract --clean",
    "translate:check": "pnpm --filter @flicktionary/i18n translate:check",
    "sync-env": "./apps/native/scripts/sync-env-if-changed.sh",
    "sync-env:force": "pnpm --filter native sync-env",
    "db:reset": "pnpm --filter @flicktionary/backend db:dev:tunnel:reset",
    "db:advance-day": "pnpm --filter @flicktionary/backend db:advance-day",
    "db:wipe": "pnpm --filter @flicktionary/backend db:dev:tunnel:wipe",
    "db:migrate": "pnpm --filter @flicktionary/backend db:dev:tunnel:migrate",
    "prepare": "husky",
    "generate:logos": "scripts/generate-logos.sh",
    "test-users": "node scripts/test-users.mjs",
    "release:extension": "node scripts/release-extension.mjs"
  },
  "devDependencies": {
    "@lingui/cli": "catalog:",
    "@lingui/format-po": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "react-email": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
