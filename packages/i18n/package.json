{
  "name": "@flicktionary/i18n",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./locales/*": "./locales/*",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "pnpm run lingui:compile && tsc && tsc-alias --project tsconfig.json",
    "check:types": "tsc --noEmit",
    "lint": "eslint . --fix --max-warnings 0",
    "lint:check": "eslint . --max-warnings 0",
    "test:watch": "vitest watch",
    "lingui:extract": "cd ../.. && pnpm exec lingui extract --clean",
    "lingui:watch": "cd ../.. && pnpm exec lingui extract --watch",
    "lingui:compile": "cd ../.. && pnpm exec lingui compile",
    "translate": "doppler run --project backend --config dev_personal -- node scripts/translate-missing.mjs",
    "translate:check": "node scripts/translate-missing.mjs --check"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@flicktionary/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "@lingui/babel-plugin-lingui-macro": "catalog:",
    "@lingui/cli": "catalog:",
    "@lingui/format-po": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@lingui/vite-plugin": "catalog:",
    "ai": "catalog:",
    "gettext-parser": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:",
    "@flicktionary/typescript-config": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "dependencies": {
    "@lingui/core": "catalog:"
  }
}
