#: apps/web/src/features/user-guide/components/user-guide-view.tsx
msgid "<0>Click</0> a word to select it, or <1>press and drag</1> to select a "
"longer phrase."
msgstr "<0>Cliquez</0> sur un mot pour le sélectionner, ou <1>appuyez et faites "
"glisser</1> pour sélectionner une phrase plus longue."

#: apps/web/src/features/user-guide/components/user-guide-view.tsx
msgid "<0>Hover</0> a word in the subtitles to see an instant definition with "
"pronunciation. The video pauses while you hover, and resumes when you "
"move away."
msgstr "<0>Survolez</0> un mot dans les sous-titres pour voir une définition "
"instantanée avec la prononciation. La vidéo se met en pause pendant le "
"survol et reprend lorsque vous vous éloignez."

#: apps/web/src/features/user-guide/components/user-guide-view.tsx
msgid "<0>No subtitles appear</0> — make sure the platform is supported and the "
"video actually has subtitle tracks. You can always load a subtitle file "
"manually by dropping it onto the video."
msgstr "<0>Aucun sous-titre n'apparaît</0> — assurez-vous que la plateforme est "
"prise en charge et que la vidéo dispose bien de pistes de sous-titres. "
"Vous pouvez toujours charger un fichier de sous-titres manuellement en "
"le déposant sur la vidéo."

#: apps/web/src/features/user-guide/components/user-guide-view.tsx
msgid "<0>Practice</0> — exercises built from your saved words to review and "
"strengthen what you learned."
msgstr "<0>Pratiquer</0> — des exercices créés à partir de vos mots sauvegardés "
"pour réviser et renforcer ce que vous avez appris."

#: apps/web/src/features/user-guide/components/user-guide-view.tsx
msgid "<0>Right-click</0> the selection and choose <1>Save</1>. The word or "
"phrase is stored in your account together with the sentence it appeared "
"in."
msgstr "<0>Faites un clic droit</0> sur la sélection et choisissez "
"<1>Enregistrer</1>. Le mot ou l'expression est stocké dans votre compte "
"avec la phrase dans laquelle il apparaît."

#: apps/web/src/features/user-guide/components/user-guide-view.tsx
msgid "<0>Saved words don't show up</0> — they appear here in the web app, not "
"in the extension. Open the app and check your latest session."
msgstr "<0>Les mots enregistrés n'apparaissent pas</0> — ils apparaissent ici "
"dans l'application web, pas dans l'extension. Ouvrez l'application et "
"consultez votre dernière session."

#: apps/web/src/features/user-guide/components/user-guide-view.tsx
msgid "<0>Saving is disabled</0> — sign in via the extension popup. If a "
"video's language isn't supported yet, you'll see a notice and saving "
"stays off for that video."
msgstr "<0>L'enregistrement est désactivé</0> — connectez-vous via la popup de "
"l'extension. Si la langue d'une vidéo n'est pas encore prise en charge, "
"vous verrez un avis et l'enregistrement restera désactivé pour cette "
"vidéo."

#: apps/web/src/features/user-guide/components/user-guide-view.tsx
msgid "<0>Sessions</0> — every video you watched and article you imported, with "
"the words you saved in each."
msgstr "<0>Sessions</0> — chaque vidéo que vous avez regardée et article que "
"vous avez importé, avec les mots que vous avez sauvegardés dans chacun."

#: apps/web/src/features/user-guide/components/user-guide-view.tsx
msgid "<0>Vocabulary</0> — all your saved words and phrases in one place."
msgstr "<0>Vocabulaire</0> — tous vos mots et expressions sauvegardés en un "
"seul endroit."

