{
  "name": "@flicktionary/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "build": "tsc && tsc-alias --project tsconfig.json",
    "check:types": "tsc --noEmit",
    "test:run": "vitest run",
    "lint": "eslint . --fix --max-warnings 0",
    "lint:check": "eslint . --max-warnings 0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "clsx": "catalog:",
    "tailwind-merge": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@flicktionary/eslint-config": "workspace:*",
    "@flicktionary/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "tsc-alias": "catalog:",
    "vitest": "catalog:"
  }
}
