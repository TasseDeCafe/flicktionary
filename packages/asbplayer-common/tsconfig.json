{
  "extends": "@flicktionary/typescript-config/react-app.json",
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    // Match the lib the extension compiles this package with (the fork uses
    // newer APIs like String.replaceAll); the shared preset only ships ES2020.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@asbplayer-fork/common": ["./index.ts"],
      "@asbplayer-fork/common/*": ["./*"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
