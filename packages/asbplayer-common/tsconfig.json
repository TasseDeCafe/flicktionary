{
  "extends": "@flicktionary/typescript-config/react-app.json",
  "compilerOptions": {
    // No rootDir: this package never emits (react-app.json sets noEmit) and it
    // now imports @flicktionary/ui|core sources from sibling workspaces, which
    // a same-dir rootDir would reject (TS6059).
    "baseUrl": ".",
    // Match the lib the extension compiles this package with (the fork uses
    // newer APIs like String.replaceAll); the shared preset only ships ES2020.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@asbplayer-fork/common": ["./index.ts"],
      "@asbplayer-fork/common/*": ["./*"],
      "@flicktionary/core/*": ["../core/src/*"],
      "@flicktionary/ui/*": ["../ui/src/*"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
