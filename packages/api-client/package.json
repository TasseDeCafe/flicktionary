{
  "name": "@flicktionary/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "build": "tsc && tsc-alias --project tsconfig.json",
    "check:types": "tsc --noEmit",
    "lint": "eslint . --fix --max-warnings 0",
    "lint:check": "eslint . --max-warnings 0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@orpc/contract": "catalog:",
    "@flicktionary/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@flicktionary/eslint-config": "workspace:*",
    "@flicktionary/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "tsc-alias": "catalog:"
  }
}
