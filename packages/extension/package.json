{
    "private": true,
    "name": "@flicktionary/extension",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:tunnel": "VITE_IS_FOR_TUNNEL=true doppler run --project web --config dev_personal -- wxt",
        "dev:tunnel:firefox": "VITE_IS_FOR_TUNNEL=true doppler run --project web --config dev_personal -- wxt -b firefox",
        "build:tunnel": "VITE_IS_FOR_TUNNEL=true doppler run --project web --config dev_personal -- wxt build",
        "dev:firefox": "wxt -b firefox",
        "dev:firefox-android": "wxt -b firefox-android --mv2",
        "build": "wxt build",
        "build:dev": "wxt build --mode development",
        "build:firefox": "wxt build -b firefox",
        "build:firefox-android": "wxt build -b firefox-android --mv2",
        "zip": "pnpm run check && wxt zip",
        "zip:firefox": "pnpm run check && wxt zip -b firefox",
        "zip:firefox-android": "pnpm run check && wxt zip -b firefox-android --mv2 --sources",
        "check:types": "tsc --noEmit",
        "postinstall": "wxt prepare",
        "check": "pnpm run lint && pnpm run check:types",
        "lint": "echo 'lint skipped (legacy fork)'",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "dependencies": {
        "@asbplayer-fork/common": "workspace:*",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@floating-ui/dom": "^1.7.4",
        "@flicktionary/api-client": "workspace:*",
        "@mui/icons-material": "^6.4.8",
        "@mui/material": "^6.4.8",
        "@mui/styles": "^6.4.8",
        "@orpc/client": "catalog:",
        "@orpc/contract": "catalog:",
        "@orpc/openapi-client": "catalog:",
        "@supabase/supabase-js": "catalog:",
        "@types/chrome": "^0.1.1",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@types/semver": "^7.7.0",
        "@types/uuid": "^10.0.0",
        "i18next": "^25.3.2",
        "i18next-resources-to-backend": "^1.2.1",
        "m3u8-parser": "^7.2.0",
        "mpd-parser": "^1.3.1",
        "react": "^19.1.0",
        "react-device-detect": "^2.2.3",
        "react-dom": "^19.1.0",
        "react-i18next": "^15.6.1",
        "regenerator-runtime": "^0.14.1",
        "semver": "^7.7.2",
        "typescript": "^5.8.3",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "catalog:",
        "@wxt-dev/module-react": "^1.1.3",
        "jsdom": "catalog:",
        "vite": "catalog:",
        "vite-tsconfig-paths": "catalog:",
        "vitest": "catalog:",
        "wxt": "catalog:"
    }
}
