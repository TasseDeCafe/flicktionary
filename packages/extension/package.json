{
    "private": true,
    "name": "@flicktionary/extension",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:tunnel": "VITE_IS_FOR_TUNNEL=true doppler run --project web --config dev_personal -- wxt",
        "dev:tunnel:firefox": "VITE_IS_FOR_TUNNEL=true doppler run --project web --config dev_personal -- wxt -b firefox",
        "build:tunnel": "VITE_IS_FOR_TUNNEL=true doppler run --project web --config dev_personal -- wxt build",
        "dev:firefox": "wxt -b firefox",
        "dev:firefox-android": "wxt -b firefox-android --mv2",
        "build": "wxt build",
        "build:dev": "wxt build --mode development",
        "build:firefox": "wxt build -b firefox",
        "build:firefox-android": "wxt build -b firefox-android --mv2",
        "zip": "pnpm run check && wxt zip",
        "zip:firefox": "pnpm run check && wxt zip -b firefox",
        "zip:firefox-android": "pnpm run check && wxt zip -b firefox-android --mv2 --sources",
        "check:types": "tsc --noEmit",
        "postinstall": "wxt prepare",
        "check": "pnpm run lint && pnpm run check:types",
        "lint": "eslint . --fix",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "dependencies": {
        "@asbplayer-fork/common": "workspace:*",
        "@emotion/react": "catalog:",
        "@emotion/styled": "catalog:",
        "@floating-ui/dom": "catalog:",
        "@flicktionary/api-client": "workspace:*",
        "@mui/icons-material": "catalog:",
        "@mui/material": "catalog:",
        "@orpc/client": "catalog:",
        "@orpc/contract": "catalog:",
        "@orpc/openapi-client": "catalog:",
        "@supabase/supabase-js": "catalog:",
        "@types/chrome": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/semver": "catalog:",
        "@types/uuid": "catalog:",
        "i18next": "catalog:",
        "i18next-resources-to-backend": "catalog:",
        "m3u8-parser": "catalog:",
        "mpd-parser": "catalog:",
        "react": "catalog:",
        "react-device-detect": "catalog:",
        "react-dom": "catalog:",
        "react-i18next": "catalog:",
        "regenerator-runtime": "catalog:",
        "semver": "catalog:",
        "tss-react": "catalog:",
        "typescript": "catalog:",
        "uuid": "catalog:"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "catalog:",
        "@typescript-eslint/parser": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "@wxt-dev/module-react": "catalog:",
        "eslint": "catalog:",
        "eslint-config-prettier": "catalog:",
        "eslint-plugin-import": "catalog:",
        "eslint-plugin-prettier": "catalog:",
        "jsdom": "catalog:",
        "prettier": "catalog:",
        "vite": "catalog:",
        "vite-tsconfig-paths": "catalog:",
        "vitest": "catalog:",
        "wxt": "catalog:"
    }
}
