{
    "private": true,
    "name": "@flicktionary/extension",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "doppler run --project extension --config dev_personal -- wxt",
        "dev:tunnel": "pnpm run dev",
        "dev:firefox": "doppler run --project extension --config dev_personal -- wxt -b firefox",
        "build": "wxt build",
        "build:dev": "doppler run --project extension --config dev_personal -- wxt build",
        "build:prod": "doppler run --project extension --config prd -- wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "pnpm run check && doppler run --project extension --config prd -- wxt zip",
        "zip:firefox": "pnpm run check && doppler run --project extension --config prd -- wxt zip -b firefox",
        "check:types": "tsc --noEmit",
        "postinstall": "wxt prepare",
        "check": "pnpm run lint && pnpm run check:types",
        "lint": "eslint . --fix",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "dependencies": {
        "@asbplayer-fork/common": "workspace:*",
        "@emotion/cache": "catalog:",
        "@emotion/react": "catalog:",
        "@emotion/styled": "catalog:",
        "@flicktionary/api-client": "workspace:*",
        "@flicktionary/i18n": "workspace:*",
        "@floating-ui/dom": "catalog:",
        "@lingui/core": "catalog:",
        "@lingui/react": "catalog:",
        "@mozilla/readability": "catalog:",
        "@mui/icons-material": "catalog:",
        "@mui/material": "catalog:",
        "@orpc/client": "catalog:",
        "@orpc/contract": "catalog:",
        "@orpc/openapi-client": "catalog:",
        "@supabase/supabase-js": "catalog:",
        "@types/chrome": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/semver": "catalog:",
        "m3u8-parser": "catalog:",
        "mpd-parser": "catalog:",
        "react": "catalog:",
        "react-device-detect": "catalog:",
        "react-dom": "catalog:",
        "regenerator-runtime": "catalog:",
        "semver": "catalog:",
        "tailwindcss": "catalog:",
        "tss-react": "catalog:",
        "typescript": "catalog:",
        "uuid": "catalog:"
    },
    "devDependencies": {
        "@lingui/babel-plugin-lingui-macro": "catalog:",
        "@rolldown/plugin-babel": "catalog:",
        "@tailwindcss/vite": "catalog:",
        "@typescript-eslint/eslint-plugin": "catalog:",
        "@typescript-eslint/parser": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "@wxt-dev/module-react": "catalog:",
        "eslint": "catalog:",
        "eslint-config-prettier": "catalog:",
        "eslint-plugin-import": "catalog:",
        "eslint-plugin-prettier": "catalog:",
        "jsdom": "catalog:",
        "prettier": "catalog:",
        "vite": "catalog:",
        "vite-tsconfig-paths": "catalog:",
        "vitest": "catalog:",
        "wxt": "catalog:"
    }
}
